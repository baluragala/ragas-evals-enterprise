# Copy to `.env` (never commit `.env`).  cp .env.example .env
OPENAI_API_KEY=sk-...your-key-here...

# Optional overrides (defaults shown)
# AURORA_APP_MODEL=gpt-4o-mini            # the assistant being evaluated
# AURORA_JUDGE_MODEL=gpt-4o-mini          # the model that grades it (try gpt-4o for stricter judging)
# AURORA_EMBED_MODEL=text-embedding-3-small
